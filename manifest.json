{
  "manifest_version": 3,
  "name": "SEMPER / IIST Eventis Sync",
  "version": "0.1.0",
  "description": "Wspomaga bezpieczną synchronizację potwierdzonych terminów szkoleń SEMPER/IIST z ogłoszeniami Eventis.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://eventis.pl/*",
    "https://*.eventis.pl/*",
    "https://szkolenia-semper.pl/*",
    "https://www.szkolenia-semper.pl/*",
    "https://szkoleniaiist.com.pl/*",
    "https://www.szkoleniaiist.com.pl/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://eventis.pl/event/add*",
        "https://eventis.pl/event/edit*",
        "https://*.eventis.pl/event/add*",
        "https://*.eventis.pl/event/edit*"
      ],
      "js": [
        "shared/config.js",
        "shared/wyszukiwanie.js",
        "shared/terminy.js",
        "shared/opisy-semper.js",
        "shared/arkusz.js",
        "shared/kolejka-eventis.js",
        "content/eventis.js"
      ],
      "css": ["content/eventis.css", "content/akcja-panelu.css", "content/porownanie-tytulow.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "action": {
    "default_title": "SEMPER / IIST Eventis Sync"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
